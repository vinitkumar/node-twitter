body
  header.bg-yankees-blue.border-b.border-black(role='banner', class='h-[50px]')
    .container.mx-auto.h-full.flex.items-center.justify-between.px-4
      if (req.isAuthenticated())
        .flex.items-center.h-full
          ul.flex.items-center.h-full.gap-1
            li.h-full
              a.flex.items-center.h-full.px-3.text-grey-blue.transition-all(href="/" title="Home", class="hover:text-twitter-blue hover:border-b-2 hover:border-twitter-blue")
                i.fas.fa-home.mr-2(aria-hidden="true")
                span(class="hidden lg:inline") Home
            li.h-full
              a.flex.items-center.h-full.px-3.text-grey-blue.transition-all(href="/users/"+req.user.id, title="Profile", class="hover:text-twitter-blue hover:border-b-2 hover:border-twitter-blue")
                i.fas.fa-user.mr-2(aria-hidden="true")
                span(class="hidden lg:inline") Profile
            li.h-full
              a.flex.items-center.h-full.px-3.text-grey-blue.transition-all(href="/analytics/", title="analytics", class="hover:text-twitter-blue hover:border-b-2 hover:border-twitter-blue")
                i.fas.fa-chart-line.mr-2(aria-hidden="true")
                span(class="hidden lg:inline") Analytics
            li.h-full
              a.flex.items-center.h-full.px-3.text-grey-blue.transition-all(href='/chat/get/' + req.user._id, title="Inbox", class="hover:text-twitter-blue hover:border-b-2 hover:border-twitter-blue")
                i.far.fa-envelope.mr-2(aria-hidden="true")
                span(class="hidden lg:inline") Inbox
            li.h-full
              a.flex.items-center.h-full.px-3.text-grey-blue.transition-all(href="/chat/", title="chat", class="hover:text-twitter-blue hover:border-b-2 hover:border-twitter-blue")
                i.far.fa-comments.mr-2(aria-hidden="true")
                span(class="hidden lg:inline") Chat
            li.h-full
              a.flex.items-center.h-full.px-3.text-grey-blue.transition-all(href="/activities", title="activity", class="hover:text-twitter-blue hover:border-b-2 hover:border-twitter-blue")
                i.far.fa-bell(aria-hidden="true")
        
        //- Logo centered
        .absolute(class="hidden lg:block left-1/2 transform -translate-x-1/2")
          a(href='/')
            img.h-6(src='/img/bird.svg')
        
        //- Right side - Tweet button and logout
        .flex.items-center.gap-4
          a.bg-twitter-blue.text-white.px-4.py-2.rounded-full.text-sm.font-medium.transition-colors(data-toggle='modal', href='.new-tweet', class="hover:bg-blue-400")
            span Tweet
          a.flex.items-center.text-grey-blue.transition-colors(href="/logout", title="logout", class="hover:text-twitter-blue")
            img.w-5.h-5.rounded-full.mr-2(src=req.user.github.avatar_url)
            span(class="hidden lg:inline") Logout
  
  if (req.isAuthenticated())
    include ../components/modals/new-tweet-modal
