.bg-yankees-blue.p-4.rounded-lg.border.border-black
  .flex.items-center.gap-3
    - if (user.github !== undefined)
      img.w-12.h-12.rounded-full.border.border-black(src=user.github.avatar_url)
    .flex-1
      - if (user.github !== undefined)
        a.text-twitter-blue.font-medium(href="/users/" + user._id, class="hover:underline") @#{user.github.login}
