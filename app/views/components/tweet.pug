.tweet.bg-yankees-blue.p-4.rounded-lg.border.border-black.mb-4(data-tweetId=tweet._id)
  .flex.gap-4
    .flex-shrink-0
      img.w-10.h-10.rounded-full.border.border-black(src=tweet.user.github.avatar_url)
    .flex-1.min-w-0
      .flex.items-center.gap-2.flex-wrap
        span.text-white.font-semibold
          - var name = tweet.user.name ? tweet.user.name : tweet.user.username
          a.transition-colors(href="/users/"+tweet.user._id, class="hover:text-twitter-blue") #{name}
        span.text-grey-blue.text-sm
          a.transition-colors(data-toggle='modal', href="#tweet-modal-"+tweet._id, class="hover:text-twitter-blue") • #{moment(tweet.createdAt).format("MMM D, YYYY [at] h:mm a")}
      //- The same replace method in app.js file
      //- TODO: find solution to reuse the same code
      -
        var tweet_m = tweet.body        
        tweet_m = tweet_m.replace(/#(\w+)/g, '<a class="text-twitter-blue hover:underline" href="/tweets/hashtag/$1">#$1</a>');      
      p.tweet__content.text-white.mt-2.break-words!= tweet_m
      
      if (tweet.user._id == req.user.id)
        .flex.gap-2.mt-3
          form.inline(action="/tweets/"+tweet.id+"?_method=POST", method="post")
            a.tweet__edit.inline-flex.items-center.bg-jungle-green.text-white.text-xs.font-medium.py-1.px-3.rounded.transition-colors(href="/tweets/"+tweet._id, type="submit", class="hover:bg-green-500") Edit
          form.inline(action="/tweets/"+tweet.id+"?_method=DELETE", method="post")
            button.tweet__delete.inline-flex.items-center.bg-go-red.text-white.text-xs.font-medium.py-1.px-3.rounded.transition-colors(type="submit", class="hover:bg-red-600") Delete
  
  include comments
