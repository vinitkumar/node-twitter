if tweet.comments && tweet.comments.length > 0
  .mt-4.pt-4.border-t.border-jungle-dark
    each comment in tweet.comments
      .flex.items-start.gap-2.mb-2
        if comment.user && comment.user.github
          img.w-5.h-5.rounded-full.border.border-black(src=comment.user.github.avatar_url)
        .flex-1
          span.text-grey-blue.text-sm #{comment.body}
