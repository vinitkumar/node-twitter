extends ../layouts/default

block content
  .max-w-6xl.mx-auto
    h1.text-3xl.font-display.font-bold.text-white.mb-8 Analytics Dashboard
    
    //- Stats Cards
    .grid.grid-cols-1.gap-6.mb-8(class="md:grid-cols-3")
      .bg-yankees-blue.p-6.rounded-lg.border.border-black.text-center
        span.block.text-3xl.font-bold.text-twitter-blue #{pageViews}
        span.text-grey-blue.mt-2.block Visits
      .bg-yankees-blue.p-6.rounded-lg.border.border-black.text-center
        span.block.text-3xl.font-bold.text-twitter-blue #{userCount}
        span.text-grey-blue.mt-2.block Users
      .bg-yankees-blue.p-6.rounded-lg.border.border-black.text-center
        span.block.text-3xl.font-bold.text-twitter-blue #{tweetCount}
        span.text-grey-blue.mt-2.block Tweets
    
    //- Analytics Table
    .bg-yankees-blue.rounded-lg.border.border-black.overflow-hidden
      table.w-full
        thead.bg-jungle-dark
          tr
            th.text-left.px-6.py-4.text-grey-blue.font-medium User
            th.text-left.px-6.py-4.text-grey-blue.font-medium(class="hidden md:table-cell") URL
            th.text-left.px-6.py-4.text-grey-blue.font-medium Time
        tbody.divide-y.divide-black
          each analytic in analytics
            if (analytic.user != null && analytic.url != null)
              - var name = analytic.user.name ? analytic.user.name : analytic.user.username
              tr.transition-colors(class="hover:bg-jungle-dark")
                td.px-6.py-4.text-white #{name}
                td.px-6.py-4.text-grey-blue.truncate.max-w-xs(class="hidden md:table-cell") #{analytic.url}
                td.px-6.py-4.text-grey-blue.text-sm #{moment(analytic.createdAt).format("MMM D, YYYY [at] h:mm a")}
    
    .mt-6
      include ../components/pagination
